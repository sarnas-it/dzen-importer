{
	"name": "sarnas-it/dzen-importer",
	"description": "WordPress plugin: import posts from a Dzen channel (full text, images, SEO fields).",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.0",
		"squizlabs/php_codesniffer": "^3.9"
	},
	"scripts": {
		"test": "phpunit",
		"lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4.0"
		}
	}
}
